// ============================================================
// schema.prisma — CRM Tenakoe v2
// Stack: Next.js + PostgreSQL + Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. UTILISATEURS & RÔLES
// ============================================================

enum Role {
  ADMIN
  CHARGEE
  PRESCRIPTEUR
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  nom              String
  prenom           String
  telephone        String?
  role             Role          @default(CHARGEE)
  password         String
  avatarUrl        String?
  actif            Boolean       @default(true)
  prescripteurType   String?
  premiereConnexion  Boolean       @default(true)
  modeGuide          Boolean       @default(true)
  guideNiveau        Int           @default(1)
  guideProgression   String?       // JSON: { aOuvertFiche: bool, aEnvoyeMail: bool, ... }
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?

  projets       Projet[]       @relation("ChargeeProjet")
  transmissions Transmission[]
  taches        Tache[]        @relation("TacheAssignee")
  tachesCreees  Tache[]        @relation("TacheCreateur")
  notes         Note[]
  alertes       Alerte[]
}

// ============================================================
// 2. CONTACTS & ENTREPRISES
// ============================================================

model Contact {
  id           String      @id @default(cuid())
  nom          String
  prenom       String
  email        String?
  telephone    String?
  fonction     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  sourceImport SourceImport? @default(MANUEL)
  sourceId     String?
}

model Entreprise {
  id                 String             @id @default(cuid())
  nom                String
  siret              String?
  adresse            String?
  codePostal         String?
  ville              String?
  departement        String?
  email              String?
  telephone          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  prescripteur       String?            @default("PDB")
  numeroCarte        String?
  depotId            String?
  depotConfig        DepotConfig?       @relation(fields: [depotId], references: [id])
  interesseTNK       InteretTNK?        @default(NSP)
  miseEnRelation     MiseEnRelation?    @default(SANS_OBJET)
  miseEnRelationAutre String?
  formationsCommentaire String?
  alerte1Envoyee     Boolean            @default(false)
  dateAlerte1        DateTime?
  alerte2Envoyee     Boolean            @default(false)
  dateAlerte2        DateTime?
  mailAbandonEnvoye  Boolean            @default(false)
  dateMailAbandon    DateTime?
  statutPrise        String             @default("NOUVEAU")
  statutFacturation  String?            @default("DEVIS_A_FAIRE")
  dejaReferentRGE    Boolean            @default(false)
  estClient          Boolean            @default(false)
  archive            Boolean            @default(false)
  sourceImport       SourceImport?      @default(MANUEL)
  sourceId           String?
  dateStatutPrise       DateTime?
  dateStatutFacturation DateTime?
  dateInteresseTNK      DateTime?
  dateMiseEnRelation    DateTime?
  dateQualification     DateTime?
  eligible              String?            @default("A_VERIFIER")
  eligibleCommentaire   String?
  dateEligible          DateTime?
  relanceJoindre1              Boolean  @default(false)
  dateRelanceJoindre1          DateTime?
  relanceJoindre2              Boolean  @default(false)
  dateRelanceJoindre2          DateTime?
  relanceJoindre3              Boolean  @default(false)
  dateRelanceJoindre3          DateTime?
  relanceJoindre4              Boolean  @default(false)
  dateRelanceJoindre4          DateTime?
  relanceJoindreInjoignable    Boolean  @default(false)
  dateRelanceJoindreInjoignable DateTime?
  relanceDevis1                Boolean  @default(false)
  dateRelanceDevis1            DateTime?
  relanceDevis2                Boolean  @default(false)
  dateRelanceDevis2            DateTime?
  relanceDevis3                Boolean  @default(false)
  dateRelanceDevis3            DateTime?
  relanceDevis4                Boolean  @default(false)
  dateRelanceDevis4            DateTime?
  relanceDevisFerme            Boolean  @default(false)
  dateRelanceDevisFerme        DateTime?

  contacts      Contact[]
  projets       Projet[]
  documents     Document[]
  transmissions Transmission[]
  taches        Tache[]
  notes         Note[]
  alertes       Alerte[]
  apporteurId   String?
  apporteur     ApporteurAffaires? @relation(fields: [apporteurId], references: [id])
  conseillerId  String?
  conseiller    Conseiller? @relation(fields: [conseillerId], references: [id])
}

model Conseiller {
  id               String       @id @default(cuid())
  nom              String
  prenom           String?
  email            String?      @unique
  telephone        String?
  prescripteurType String
  actif            Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  entreprises      Entreprise[]
}

// ============================================================
// 3. ENUMS MÉTIER
// ============================================================


// Statuts dynamiques (gérés depuis Paramètres → Pipeline)
model StatutPriseConfig {
  id        String   @id @default(cuid())
  nom       String
  code      String   @unique // Ex: "NOUVEAU", "PRISE_EN_CHARGE"
  couleur   String   @default("#3b82f6")
  icone     String?  @default("circle")
  ordre     Int
  actif     Boolean  @default(true)
  parDefaut Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatutFacturationConfig {
  id                  String   @id @default(cuid())
  nom                 String
  code                String   @unique
  couleur             String   @default("#7c3aed")
  icone               String?  @default("circle")
  ordre               Int
  actif               Boolean  @default(true)
  parDefaut           Boolean  @default(false)
  declencheConversion Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}


enum InteretTNK {
  OUI
  NON
  NSP
}

enum MiseEnRelation {
  SANS_OBJET
  APEE
  CEEF
  HORMEE
  FORMATION_RENOPERF
  AUTRE
}

enum SourceImport {
  MANUEL
  CAPSULE
  NOTION
  CSV
  FORMULAIRE
}

// ============================================================
// 4. PROJETS & QUALIFICATIONS
// ============================================================

model Projet {
  id           String  @id @default(cuid())
  nom          String
  description  String?
  actif        Boolean @default(true)
  archive      Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  chargeeId    String?
  chargee      User?   @relation("ChargeeProjet", fields: [chargeeId], references: [id])
  antenneQualibatId     String?
  antenneQualibat       AntenneQualibat? @relation(fields: [antenneQualibatId], references: [id])
  interlocuteurQualibat String?
  dateCommission        DateTime?
  identifiantQualibat   String?
  motDePasseQualibat    String?
  certificateurType     String?
  emailCertificateur    String?
  bonCommandeDemande    Boolean   @default(false)
  dateBonCommandeDemande DateTime?
  bonCommandePaye       Boolean   @default(false)
  dateBonCommandePaye   DateTime?

  qualifications ProjetQualification[]
  etapes         Etape[]
  documents      Document[]
  taches         Tache[]
  bonsDeCommande BonDeCommande[]
  chantiers      Chantier[]
  sourceImport   SourceImport? @default(MANUEL)
  sourceId       String?
}

model AntenneQualibat {
  id         String   @id @default(cuid())
  nom        String   @unique
  delegation String?
  delegue    String?
  adresse    String?
  telephone  String?
  email      String?
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  projets    Projet[]
  projetQualifications ProjetQualification[]
}

model DepartementQualibat {
  id          String @id @default(cuid())
  departement String @unique
  delegation  String
  email       String
  telephone   String
}

model ProjetQualification {
  id                  String   @id @default(cuid())
  projetId            String
  projet              Projet   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  type                String
  formationITI        Boolean  @default(false)
  formationITE              Boolean  @default(false)
  formationMenuiserie       Boolean  @default(false)
  formationQUALIPAC         Boolean  @default(false)
  formationTR               Boolean  @default(false)
  formationMenuiserieExt    Boolean  @default(false)
  formationVMC              Boolean  @default(false)
  formationToituresVelux    Boolean  @default(false)
  formationToituresTerrasses Boolean @default(false)
  formationEmetteursElec    Boolean  @default(false)
  formationChaudiereCogen   Boolean  @default(false)
  formationBT               Boolean  @default(false)
  formationHorsRenoperfITI  Boolean  @default(false)
  formationHorsRenoperfITE  Boolean  @default(false)
  formationAutre            String?
  titulaireRenove           Boolean  @default(false)
  niveauVise                String?
  niveauObtenu              String?

  certificateurType         String?
  emailCertificateur        String?
  antenneQualibatId         String?
  antenneQualibat           AntenneQualibat? @relation(fields: [antenneQualibatId], references: [id])
  identifiantCertificateur  String?
  motDePasseCertificateur   String?
  interlocuteurCertificateur String?
  dateCommission            DateTime?
  bonCommandeDemande        Boolean  @default(false)
  dateBonCommandeDemande    DateTime?
  bonCommandePaye           Boolean  @default(false)
  dateBonCommandePaye       DateTime?
  bonCommandeFichierUrl     String?
  bonCommandeFichierNom     String?

  rges                      ProjetQualificationRGE[]
  chantiers                 Chantier[]

  @@unique([projetId, type])
}

model NomenclatureRGE {
  id    String  @id @default(cuid())
  code  String  @unique
  nom   String
  actif Boolean @default(true)
}

model ProjetQualificationRGE {
  id                    String              @id @default(cuid())
  projetQualificationId String
  projetQualification   ProjetQualification @relation(fields: [projetQualificationId], references: [id], onDelete: Cascade)
  rgeCode               String

  @@unique([projetQualificationId, rgeCode])
}

model BonDeCommande {
  id                String    @id @default(cuid())
  projetId          String
  projet            Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
  qualificationCode String
  reference         String?
  montant           Float?
  paye              Boolean   @default(false)
  datePaiement      DateTime?
  dateEmission      DateTime?
  commentaire       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Chantier {
  id                    String    @id @default(cuid())
  projetId              String?
  projet                Projet?   @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetQualificationId String?
  projetQualification   ProjetQualification? @relation(fields: [projetQualificationId], references: [id], onDelete: Cascade)
  numero                Int
  nom                   String?
  description           String?
  devisRecu             Boolean   @default(false)
  devisFichierUrl       String?
  devisFichierNom       String?
  dateDevis             DateTime?
  factureRecue          Boolean   @default(false)
  factureFichierUrl     String?
  factureFichierNom     String?
  dateFacture           DateTime?
  attestationRecue      Boolean   @default(false)
  attestationFichierUrl String?
  attestationFichierNom String?
  dateAttestation       DateTime?
  photosRecues          Boolean   @default(false)
  photosFichierUrl      String?
  photosFichierNom      String?
  datePhotos            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  documents             ChantierDocument[]

  @@unique([projetQualificationId, numero])
}

model ChantierDocument {
  id            String    @id @default(cuid())
  chantierId    String
  chantier      Chantier  @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  nom           String
  fichierUrl    String?
  fichierNom    String?
  fichierTaille Int?
  createdAt     DateTime  @default(now())
}

// ============================================================
// 5. FEUILLE DE ROUTE / TRACKS
// ============================================================

model TrackTemplate {
  id          String               @id @default(cuid())
  nom         String
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  etapes      TrackTemplateEtape[]
}

model TrackTemplateEtape {
  id              String        @id @default(cuid())
  nom             String
  description     String?
  ordre           Int
  delaiJours      Int
  trackTemplateId String
  trackTemplate   TrackTemplate @relation(fields: [trackTemplateId], references: [id], onDelete: Cascade)

  @@unique([trackTemplateId, ordre])
}

model Etape {
  id           String    @id @default(cuid())
  nom          String
  description  String?
  ordre        Int
  delaiJours   Int?
  dateObjectif DateTime?
  dateRealisee DateTime?
  active       Boolean   @default(false)
  terminee     Boolean   @default(false)
  enRetard     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projetId     String
  projet       Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
}

// ============================================================
// 6. DOCUMENTS
// ============================================================

enum TypeDocument {
  TRONC_COMMUN
  SPECIFIQUE
}

model Document {
  id                    String             @id @default(cuid())
  nom                   String
  type                  TypeDocument       @default(TRONC_COMMUN)
  recu                  Boolean            @default(false)
  dateReception         DateTime?
  dateDemande           DateTime?
  fichierUrl            String?
  fichierNom            String?
  fichierTaille         Int?
  notes                 String?
  conformite            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  entrepriseId          String
  entreprise            Entreprise         @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  projetId              String?
  projet                Projet?            @relation(fields: [projetId], references: [id], onDelete: SetNull)
  qualificationAssociee String?
}

model DocumentTemplate {
  id            String       @id @default(cuid())
  nom           String
  type          TypeDocument @default(TRONC_COMMUN)
  qualification String?
  obligatoire   Boolean      @default(true)
  ordre         Int          @default(0)
}

// ============================================================
// 7. TRANSMISSIONS
// ============================================================

enum CanalTransmission {
  EMAIL
  SMS
  TELEPHONE
}

enum DirectionTransmission {
  SORTANT
  ENTRANT
}

model Transmission {
  id              String                @id @default(cuid())
  canal           CanalTransmission
  direction       DirectionTransmission @default(SORTANT)
  destinataire    String
  expediteurEmail String?
  objet           String?
  contenu         String?
  dateEnvoi       DateTime              @default(now())
  lu              Boolean               @default(false)
  archive         Boolean               @default(false)
  gmailMessageId  String?
  gmailThreadId   String?
  expediteurId    String?
  expediteur      User?                 @relation(fields: [expediteurId], references: [id])
  entrepriseId    String?
  entreprise      Entreprise?           @relation(fields: [entrepriseId], references: [id])
  automatique     Boolean               @default(false)
  statutEnvoi     String?               @default("ENVOYE")
  erreur          String?
}

model MailTemplate {
  id        String   @id @default(cuid())
  nom       String   @unique
  objet     String
  contenu   String
  categorie String?
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// 8. TÂCHES
// ============================================================

enum TypeTache {
  APPEL
  EMAIL
  REUNION
  ENVOI
  RELANCE
  SUIVI
  AUTRE
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  TERMINEE
  ANNULEE
}

model Tache {
  id              String      @id @default(cuid())
  titre           String
  description     String?
  type            TypeTache   @default(AUTRE)
  statut          StatutTache @default(A_FAIRE)
  priorite        Int         @default(0)
  dateEcheance    DateTime?
  dateRealisee    DateTime?
  recurrente      Boolean     @default(false)
  recurrenceJours Int?
  enRetard        Boolean     @default(false)
  rappelEnvoye    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  assigneeId      String?
  assignee        User?       @relation("TacheAssignee", fields: [assigneeId], references: [id])
  createurId      String?
  createur        User?       @relation("TacheCreateur", fields: [createurId], references: [id])
  entrepriseId    String?
  entreprise      Entreprise? @relation(fields: [entrepriseId], references: [id])
  projetId        String?
  projet          Projet?     @relation(fields: [projetId], references: [id])
}

// ============================================================
// 9. NOTES INTERNES
// ============================================================

model Note {
  id            String     @id @default(cuid())
  contenu       String
  epinglee      Boolean    @default(false)
  fichierUrl    String?
  fichierNom    String?
  fichierTaille Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  auteurId      String
  auteur        User       @relation(fields: [auteurId], references: [id])
  entrepriseId  String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
}

// ============================================================
// 10. ALERTES & RAPPELS
// ============================================================

enum TypeAlerte {
  RETARD_TACHE
  RETARD_ETAPE
  DOCUMENT_MANQUANT
  RELANCE_48H
  RAPPEL_ECHEANCE
}

model Alerte {
  id           String      @id @default(cuid())
  type         TypeAlerte
  message      String
  lue          Boolean     @default(false)
  emailEnvoye  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
}

// ============================================================
// 11. FORMULAIRE PRESCRIPTEUR (leads)
// ============================================================

model LeadFormulaire {
  id               String       @id @default(cuid())
  nomArtisan       String
  prenomArtisan    String
  nomEntreprise    String?
  siret            String?
  email            String?
  telephone        String?
  telephone2       String?
  adresse          String?
  departement      String?
  prescripteur     String
  depot            String?
  depotConfigId    String?
  depotConfig      DepotConfig?   @relation(fields: [depotConfigId], references: [id])
  numeroCarte      String?
  dejaReferentRGE  Boolean      @default(false)
  commentaires     String?
  acceptePartage   Boolean      @default(false)
  interesseAccompagnement String?
  dateTransmission DateTime     @default(now())
  createdAt        DateTime     @default(now())
  statut           String       @default("NOUVEAU")
  converti         Boolean      @default(false)
  entrepriseId        String?
  sourceImport        String?
  sourceId            String?
  nomConseiller       String?
  prenomConseiller    String?
  emailConseiller     String?
  telephoneConseiller String?
}

// ============================================================
// 12. INTÉGRATIONS
// ============================================================

model Integration {
  id          String    @id @default(cuid())
  nom         String
  type        String
  actif       Boolean   @default(false)
  config      String?
  dernierSync DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// 13. PARAMÈTRES
// ============================================================

model Parametre {
  id          String   @id @default(cuid())
  cle         String   @unique
  valeur      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// 14. LOGS D'ACTIVITÉ
// ============================================================

enum TypeActivite {
  CREATION
  MODIFICATION
  SUPPRESSION
  CHANGEMENT_STATUT
  ENVOI_EMAIL
  ENVOI_SMS
  APPEL
  UPLOAD_DOCUMENT
  RECEPTION_DOCUMENT
  AFFECTATION
  CONNEXION
  NOTE
}

// ============================================================
// WEBHOOKS
// ============================================================

model Webhook {
  id         String             @id @default(cuid())
  nom        String
  url        String
  secret     String?
  actif      Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  evenements WebhookEvenement[]
}

model WebhookEvenement {
  id        String  @id @default(cuid())
  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  type      String

  @@unique([webhookId, type])
}

// ============================================================
// PRESCRIPTEURS CONFIG (dynamique, archivable)
// ============================================================

model PrescripteurConfig {
  id      String  @id @default(cuid())
  type    String  @unique
  nom     String
  logoUrl String?
  actif   Boolean @default(true)
}

model DepotConfig {
  id               String   @id @default(cuid())
  nom              String
  prescripteurType String
  actif            Boolean  @default(true)
  ordre            Int      @default(0)
  createdAt        DateTime @default(now())

  entreprises      Entreprise[]
  leads            LeadFormulaire[]

  @@unique([nom, prescripteurType])
}

model NomenclatureQualibat {
  id        String   @id @default(cuid())
  code      String   @unique
  nom       String
  categorie String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LogActivite {
  id          String       @id @default(cuid())
  type        TypeActivite
  description String
  entite      String
  entiteId    String
  userId      String?
  metadata    String?
  createdAt   DateTime     @default(now())

  @@index([entite, entiteId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// APPORTEURS D'AFFAIRES
// ============================================================

enum StatutApporteur {
  ACTIF
  INACTIF
  A_CONTACTER
}

model ApporteurAffaires {
  id          String           @id @default(cuid())
  nom         String
  prenom      String?
  structure   String?
  email       String?
  telephone   String?
  statut      StatutApporteur  @default(A_CONTACTER)
  commentaire String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  entreprises Entreprise[]
}

model Ressource {
  id            String   @id @default(cuid())
  nom           String
  description   String?
  categorie     String?
  fichierUrl    String
  fichierNom    String
  fichierTaille Int?
  uploadParId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
